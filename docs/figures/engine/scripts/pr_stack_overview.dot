digraph stack {
  graph [rankdir=LR, fontname="Helvetica", fontsize=10, nodesep=0.25, ranksep=0.3, bgcolor="white"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9, fillcolor="#FFFFFF"];
  edge [color="#000000"];
  main [label="main", shape=cylinder, fillcolor="#00000010"];
  subgraph cluster_ind { label="independent PRs (merge first)"; style=dashed; fontsize=9;
    x55 [label="#55 x-points copy"]; rip [label="reversed-Ip hotfix\n(16 commits)"]; e63 [label="#63 + errorbar fixes\n(14 commits)"]; hf [label="core-pressure\nhealth flag (1)"]; }
  s01 [label="01 MSE term\n1 commit", fillcolor="#56B4E933"];
  s02 [label="02 j_BS loop kernel\n(default OFF)", fillcolor="#56B4E933"];
  s03 [label="03 loop ON by default,\nschema v3, golden", fillcolor="#56B4E933"];
  s04 [label="04 reversed-Ip\n(cherry-picks)", fillcolor="#E69F0033"];
  s05 [label="05 loop review fixes,\none reconstruction state", fillcolor="#56B4E933"];
  s06 [label="06 engine base:\nMSE review fixes", fillcolor="#009E7333"];
  s07 [label="07 unified engine\n(opt-in)", fillcolor="#009E7333"];
  s08 [label="08 engine draws,\nrefresh + cap", fillcolor="#009E7333"];
  s09 [label="09 reversed-Ip review\nfixes, engine orientation", fillcolor="#E69F0033"];
  s10 [label="10 validation fixes\n+ edge pressure", fillcolor="#009E7333"];
  s11 [label="11 owner-approved\ndefaults", fillcolor="#D55E0033"];
  s12 [label="12 review fixes,\nowner decisions, golden", fillcolor="#D55E0033"];
  s13 [label="13 top: merge main,\nfigures, docs", fillcolor="#CC79A733"];
  rel [label="#54 release\n(rewritten changelog)", shape=box];
  main -> s01 -> s02 -> s03 -> s04 -> s05 -> s06 -> s07 -> s08 -> s09 -> s10 -> s11 -> s12 -> s13;
  main -> x55; main -> rip; main -> e63; main -> hf;
  s13 -> rel [style=dashed, label=" last"];
}
