*.nc
*.cdf
*.dat
*.npz
*.npy
*.mat

# Fortran / compiled artifacts (in case any build steps live nearby)
*.mod
*.o
*.so
*.a

# TokaMaker / OFT runtime output (adjust to actual filenames)
*.eqdsk
*.geqdsk
!examples/**/*.eqdsk
!examples/**/*.geqdsk
g*.txt        # EFIT-style g-files if relevant

