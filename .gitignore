*.ipynb_checkpoints

# Virtual environments
.venv/
venv/
env/

# Scientific output files (add formats you actually use)
*.h5
*.hdf5
# ...but DO track the committed golden test fixtures (small, slimmed)
!tests/golden/*.h5
# ...and the small DIII-D mesh the solver suite needs in CI (~432 KB)
!examples/D3D-like/DIIID_mesh.h5
